        "language": "javaScript",
        "jsCode": "const j = $input.item.json;\nconst raw = j.content ?? j.text ?? j.response ?? (typeof j === 'string' ? j : JSON.stringify(j));\nconst topic = String(raw).trim().replace(/^\"|\"$/g, '');\n\nreturn {\n  json: {\n    topic,\n  },\n};"
      }
